<Window
    x:Class="RemoteBuilder.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="RemoteBuilder Agent">

  <Grid RowSpacing="10" Padding="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
    </Grid.RowDefinitions>

    <tb:TaskbarIcon
        x:Name="TrayIcon"
        ToolTipText="RemoteBuilder"
        MenuActivation="RightClick"
        PopupActivation="DoubleClick">
      <tb:TaskbarIcon.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem
              Text="Show / hide window"
              Click="ShowHide_Click" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem
              Text="Refresh now"
              Click="Refresh_Click" />
          <MenuFlyoutItem
              Text="Check for updates"
              Click="CheckUpdates_Click" />
          <MenuFlyoutItem
              Text="Open releases page"
              Click="OpenReleases_Click" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem
              Text="Exit"
              Click="Exit_Click" />
        </MenuFlyout>
      </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>

    <StackPanel
        Grid.Row="0"
        Orientation="Horizontal"
        Spacing="12">
      <TextBlock
          Text="RemoteBuilder Agent"
          FontSize="20"
          FontWeight="SemiBold" />
      <TextBlock
          x:Name="StatusText"
          VerticalAlignment="Center"
          Text="starting…" />
    </StackPanel>

    <StackPanel
        Grid.Row="1"
        Orientation="Horizontal"
        Spacing="28">
      <StackPanel>
        <TextBlock Opacity="0.6" Text="MACHINE" />
        <TextBlock x:Name="MachineText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
      <StackPanel>
        <TextBlock Opacity="0.6" Text="CORES" />
        <TextBlock x:Name="CoresText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
      <StackPanel>
        <TextBlock Opacity="0.6" Text="CPU LOAD" />
        <TextBlock x:Name="LoadText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
      <StackPanel>
        <TextBlock Opacity="0.6" Text="MEMORY" />
        <TextBlock x:Name="MemText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
      <StackPanel>
        <TextBlock Opacity="0.6" Text="JOBS" />
        <TextBlock x:Name="JobsText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
      <StackPanel>
        <TextBlock Opacity="0.6" Text="AGENT" />
        <TextBlock x:Name="AgentText" FontWeight="SemiBold" Text="—" />
      </StackPanel>
    </StackPanel>

    <StackPanel
        Grid.Row="2"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="RefreshButton"
          Click="Refresh_Click"
          Content="Refresh" />
      <Button
          x:Name="UpdateButton"
          Click="CheckUpdates_Click"
          Content="Check for updates" />
      <Button
          Click="OpenReleases_Click"
          Content="Open releases page" />
      <Button
          x:Name="KillButton"
          Click="Kill_Click"
          Content="Kill selected job" />
    </StackPanel>

    <ListView
        x:Name="JobsList"
        Grid.Row="4"
        SelectionChanged="JobsList_SelectionChanged">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="4,2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Id}" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" />
            <TextBlock Grid.Column="2" Text="{Binding Exit}" />
            <TextBlock Grid.Column="3" Text="{Binding LogSize}" />
            <TextBlock
                Grid.Column="4"
                Text="{Binding Cmd}"
                TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock
        Grid.Row="5"
        Opacity="0.6"
        Text="LOG" />
    <ScrollViewer
        x:Name="LogScroll"
        Grid.Row="6"
        VerticalScrollBarVisibility="Auto">
      <TextBlock
          x:Name="LogText"
          FontFamily="Consolas"
          FontSize="12"
          TextWrapping="NoWrap" />
    </ScrollViewer>
  </Grid>
</Window>

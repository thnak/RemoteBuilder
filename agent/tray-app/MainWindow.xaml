<Window
    x:Class="RemoteBuilder.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="RemoteBuilder Agent">

  <Grid Padding="14">
    <Grid x:Name="MainPanel" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>

      <tb:TaskbarIcon
          x:Name="TrayIcon"
          ToolTipText="RemoteBuilder"
          MenuActivation="RightClick"
          PopupActivation="DoubleClick">
        <tb:TaskbarIcon.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem
                Text="Show / hide window"
                Click="ShowHide_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Text="Refresh now"
                Click="Refresh_Click" />
            <MenuFlyoutItem
                Text="Check for updates"
                Click="CheckUpdates_Click" />
            <MenuFlyoutItem
                Text="Open releases page"
                Click="OpenReleases_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Text="Settings…"
                Click="ShowSettings_Click" />
            <MenuFlyoutItem
                Text="Exit"
                Click="Exit_Click" />
          </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
      </tb:TaskbarIcon>

      <Grid Grid.Row="0" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="0"
            Text="RemoteBuilder Agent"
            FontSize="20"
            FontWeight="SemiBold" />
        <TextBlock
            x:Name="StatusText"
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="starting…" />
        <Button
            Grid.Column="2"
            Click="ShowSettings_Click"
            Content="Settings" />
      </Grid>

      <StackPanel
          Grid.Row="1"
          Orientation="Horizontal"
          Spacing="28">
        <StackPanel>
          <TextBlock Opacity="0.6" Text="MACHINE" />
          <TextBlock x:Name="MachineText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
        <StackPanel>
          <TextBlock Opacity="0.6" Text="CORES" />
          <TextBlock x:Name="CoresText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
        <StackPanel>
          <TextBlock Opacity="0.6" Text="CPU LOAD" />
          <TextBlock x:Name="LoadText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
        <StackPanel>
          <TextBlock Opacity="0.6" Text="MEMORY" />
          <TextBlock x:Name="MemText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
        <StackPanel>
          <TextBlock Opacity="0.6" Text="JOBS" />
          <TextBlock x:Name="JobsText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
        <StackPanel>
          <TextBlock Opacity="0.6" Text="ENDPOINT" />
          <TextBlock x:Name="AgentText" FontWeight="SemiBold" Text="—" />
        </StackPanel>
      </StackPanel>

      <StackPanel
          Grid.Row="2"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            x:Name="RefreshButton"
            Click="Refresh_Click"
            Content="Refresh" />
        <Button
            x:Name="UpdateButton"
            Click="CheckUpdates_Click"
            Content="Check for updates" />
        <Button
            Click="OpenReleases_Click"
            Content="Open releases page" />
        <Button
            x:Name="KillButton"
            Click="Kill_Click"
            Content="Kill selected job" />
      </StackPanel>

      <ListView
          x:Name="JobsList"
          Grid.Row="4"
          SelectionChanged="JobsList_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,2" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Id}" />
              <TextBlock Grid.Column="1" Text="{Binding Status}" />
              <TextBlock Grid.Column="2" Text="{Binding Exit}" />
              <TextBlock Grid.Column="3" Text="{Binding LogSize}" />
              <TextBlock
                  Grid.Column="4"
                  Text="{Binding Cmd}"
                  TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <TextBlock
          Grid.Row="5"
          Opacity="0.6"
          Text="LOG" />
      <ScrollViewer
          x:Name="LogScroll"
          Grid.Row="6"
          VerticalScrollBarVisibility="Auto">
        <TextBlock
            x:Name="LogText"
            FontFamily="Consolas"
            FontSize="12"
            TextWrapping="NoWrap" />
      </ScrollViewer>
    </Grid>

    <ScrollViewer
        x:Name="SettingsPanel"
        Visibility="Collapsed"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
              Grid.Column="0"
              Text="Settings"
              FontSize="20"
              FontWeight="SemiBold"
              VerticalAlignment="Center" />
          <Button
              Grid.Column="1"
              Click="CancelSettings_Click"
              Content="Back" />
        </Grid>

        <TextBlock Text="Agent connection" FontWeight="SemiBold" />
        <Grid ColumnSpacing="12" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              Text="Host"
              VerticalAlignment="Center" />
          <TextBox
              x:Name="HostBox"
              Grid.Row="0"
              Grid.Column="1" />

          <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Text="Port"
              VerticalAlignment="Center" />
          <TextBox
              x:Name="PortBox"
              Grid.Row="1"
              Grid.Column="1"
              Width="120"
              HorizontalAlignment="Left" />

          <TextBlock
              Grid.Row="2"
              Grid.Column="0"
              Text="Refresh interval (s)"
              VerticalAlignment="Center" />
          <TextBox
              x:Name="IntervalBox"
              Grid.Row="2"
              Grid.Column="1"
              Width="120"
              HorizontalAlignment="Left" />

          <TextBlock
              Grid.Row="3"
              Grid.Column="0"
              Text="Token"
              VerticalAlignment="Center" />
          <PasswordBox
              x:Name="TokenBox"
              Grid.Row="3"
              Grid.Column="1"
              PlaceholderText="leave blank to use the shared token file" />

          <TextBlock
              x:Name="TokenHintText"
              Grid.Row="4"
              Grid.Column="1"
              Opacity="0.6"
              TextWrapping="Wrap" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Click="Test_Click" Content="Test connection" />
          <TextBlock
              x:Name="TestResultText"
              VerticalAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Agent service" FontWeight="SemiBold" />
        <TextBlock x:Name="ServiceStatusText" Text="checking…" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Click="ServiceStart_Click" Content="Start" />
          <Button Click="ServiceStop_Click" Content="Stop" />
          <Button Click="ServiceRestart_Click" Content="Restart" />
        </StackPanel>
        <TextBlock
            Opacity="0.6"
            TextWrapping="Wrap"
            Text="Controlling the service raises an administrator prompt." />

        <TextBlock Text="Startup" FontWeight="SemiBold" />
        <CheckBox
            x:Name="AutostartCheck"
            Content="Start the tray monitor when I sign in" />

        <TextBlock
            x:Name="SaveMessageText"
            TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Click="Save_Click" Content="Save" />
          <Button Click="CancelSettings_Click" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
